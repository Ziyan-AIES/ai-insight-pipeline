{
  "name": "ai-insight-pipeline",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "migrate:legacy": "node scripts/migrate-legacy-data.mjs",
    "editorial:export": "node scripts/export-editorial-queue.mjs",
    "editorial:check": "tsx scripts/run-local-editorial.ts --check",
    "editorial:local": "tsx scripts/run-local-editorial.ts",
    "editorial:schedule": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/register-editorial-task.ps1"
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.26",
    "@supabase/supabase-js": "^2.112.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "tsx": "^4.23.5",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  },
  "overrides": {
    "postcss": "8.5.23"
  }
}
