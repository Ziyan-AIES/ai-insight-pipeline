{
  "name": "ai-insight-pipeline",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:extension": "node scripts/verify-extension-worker.mjs",
    "test:db": "supabase test db",
    "preview": "vite preview",
    "migrate:legacy": "node scripts/migrate-legacy-data.mjs",
    "editorial:export": "node scripts/export-editorial-queue.mjs",
    "editorial:check": "tsx scripts/run-local-editorial.ts --check",
    "editorial:local": "tsx scripts/run-local-editorial.ts",
    "editorial:drain": "tsx scripts/run-local-editorial.ts --drain",
    "editorial:schedule": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/register-pipeline-tasks.ps1",
    "pilot:report": "node scripts/pilot-report.mjs",
    "reference:brief": "node scripts/run-reference-brief.mjs",
    "reference:dictionary": "node scripts/export-reference-dictionary.mjs",
    "mail:collect": "node scripts/collect-mail-queue.mjs",
    "research:check": "node scripts/run-research-enrichment.mjs --check",
    "research:drain": "node scripts/run-research-enrichment.mjs",
    "test:research-synthesis": "node --test scripts/research-synthesis.test.mjs scripts/research-product-enrichment.test.mjs",
    "research:import-products": "node scripts/import-research-products.mjs",
    "test:research-db": "node scripts/validate-research-db.mjs",
    "pipeline:intake": "node --import ./scripts/local-network.mjs scripts/run-daily-pipeline.mjs --stage=intake",
    "pipeline:editorial": "node --import ./scripts/local-network.mjs scripts/run-daily-pipeline.mjs --stage=editorial",
    "pipeline:check": "node --import ./scripts/local-network.mjs scripts/run-daily-pipeline.mjs --check",
    "pipeline:schedule": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/register-pipeline-tasks.ps1"
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.26",
    "@supabase/supabase-js": "^2.112.0",
    "ipaddr.js": "^2.5.0",
    "jspdf": "^4.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "undici-pinned": "npm:undici@^6.28.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^30.0.1",
    "oxlint": "^1.75.0",
    "supabase": "^2.116.0",
    "tsx": "^4.23.5",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "8.5.23",
    "@connectrpc/connect-node": {
      "undici": "^6.28.0"
    }
  }
}
